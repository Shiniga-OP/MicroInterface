{
    pacote: "com.micro.util",
    nome: "FabricaUtil",
    exemplo: `
    // criar um pixel de cor sólida
    Texture fundo = FabricaUtil.criarPixel(Color.BLACK, 320, 180);
    
    // criar linha de configuração numérica
    Painel linhaVolume = FabricaUtil.criarConfigNum(
        0, 0, 400, 40,
        "Volume", "10",
        fonte, 1.5f, visualBotao,
        new Acao() {
            @Override
            public void exec() {volume--}
        },
        new Acao() {
            @Override
            public void exec() {volume++}
        }
    );
    ui.add(linhaVolume);
    
    // criar botão alternável
    Botao musica = FabricaUtil.criarSelecao(
        0, 0, 200, 40,
        "Música", fonte, 1.5f,
        pixelBranco, true,
        new Acao() {
            @Override public void exec() {alternarMusica();}
        }
    );
    ui.add(musica);
    `,
    metodos: [
        {
            nome: "criarConfigNum",
            args: "float x, float y, float largura, float altura, String titulo, String valorInicial, BitmapFont fonte, float escala, PainelFatiado visualBotao, Acao menos, Acao mais",
            retorno: "Painel",
            faz: "Monta um painel de configuração numérica com rótulo de título, rótulo de valor e dois botões (− e +) com as ações correspondentes."
        },
        {
            nome: "criarPixel",
            args: "Color cor",
            retorno: "Texture",
            faz: "Atalho de criarPixel(cor, 1, 1). Cria um pixel 1×1 da cor informada, ideal para uso rápido."
        },
        {
            nome: "criarSelecao",
            args: "float x, float y, float largura, float altura, String texto, BitmapFont fonte, float escala, Texture pixelBranco, boolean estadoInicial, Acao acao",
            retorno: "Botao",
            faz: "Cria um Botao alternável já configurado com tornarAlternavel(estadoInicial). O estadoInicial define se começa ligado ou desligado."
        }
    ]
}