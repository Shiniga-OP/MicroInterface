{
    pacote: "com.micro.util",
    nome: "GerenciadorUI",
    construtores: [
        ""
    ],
    exemplo: `
    public GerenciadorUI ui;
    public SpriteBatch pincel;
    public Bitmap fonte;
    
    @Override
    public show() {
        fonte = new Bitmap();
        Rotulo titulo = new Rotulo("exemplo", fonte, 2.0f);
        ui = new GerenciadorUI();
        ui.add(titulo);
        pincel = new SpriteBatch();
    }
    
    @Override
    public void render(float delta) {
        pincel.begin();
        ui.desenhar(pincel, delta);
        pincel.end();
    }
    
    @Override
    public void dispose() {
        ui.liberar();
        fonte.dispose();
    }
    `,
    campos: `
